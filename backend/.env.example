# Backend environment (placeholders - copy to .env for local dev).
# --- Core ---
APP_NAME="Movie Recommendation System"
APP_VERSION="1.0.0"
ENVIRONMENT="development"

# --- CORS (comma-separated allowed frontend origins) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- Database (SQLAlchemy URL) ---
# SQLite for local dev; PostgreSQL recommended for production.
DATABASE_URL=sqlite:///./app.db

# --- Dataset ---
# ML-100K by default. Supported: ml-100k | ml-1m | ml-25m.
MOVIELENS_DATASET=ml-100k
# Relative to backend/.
DATA_DIR=./data
ARTIFACTS_DIR=./artifacts

# --- Recommender tuning ---
POPULARITY_MIN_RATINGS=20
HYBRID_WEIGHT_POPULARITY=0.20
HYBRID_WEIGHT_CONTENT=0.35
HYBRID_WEIGHT_COLLABORATIVE=0.45

# --- TMDB (OPTIONAL; core recommender works without it) ---
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/w500
TMDB_TIMEOUT_SECONDS=5

# --- Demo account (LOCAL DEMO MODE ONLY - do NOT use in production) ---
DEMO_USER_ID=1
DEMO_USER_EMAIL=demo@example.com
